APP_BASE_URL=http://127.0.0.1:3100
DATABASE_PATH=./data/acquisition-demo.sqlite

# OpenAI 标准兼容接口（DeepSeek、OpenAI 或其他兼容服务）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_THINKING_MODE=enabled
LLM_REASONING_EFFORT=max
LLM_CONTEXT_WINDOW_TOKENS=1000000
LLM_MODEL_MAX_OUTPUT_TOKENS=384000
LLM_MAX_OUTPUT_TOKENS=65536
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# 仅允许向白名单地址真实发送；多个地址用逗号分隔
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_ALLOWLIST=test@example.com
